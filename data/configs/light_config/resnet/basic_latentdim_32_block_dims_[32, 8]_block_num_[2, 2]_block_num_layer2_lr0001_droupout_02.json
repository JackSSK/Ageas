{
    "max_epochs": 5,
    "model_params": {
        "latent_planes": 64,
        "latent_fea_dim": 10,
        "global_conv": true,
        "block": "ResNet_Basic",
        "block_nums": [1, 1],
        "block_planes": [32, 8],
        "dropout": 0.2,
        "zero_init_residual": false,
        "groups": 1,
        "dilation": 1,
        "width_per_group": 64,
        "replace_stride_with_dilation": false,
        "norm_layer": "BatchNorm1d"
    },
    "train_config": {
        "batch_size": 10,
        "precision": 32,
        "num_nodes": 1,
        "log_every_n_steps": 1,
        "accumulate_grad_batches": 1,
        "gradient_clip_val": 0.5,
        "gradient_clip_algorithm": "value",
        "ckpt_every_n_epochs": 1,
        "save_last": true,
        "monitor": "vali.accuracy",
        "save_top_k_ckpt": 1,
        "gradient_accum_schedule": null,
        "loss_reduction": "mean",
        "optimizer": "adamw",
        "learning_rate": 0.001,
        "weight_decay": 0.001,
        "betas": [0.9, 0.999],
        "momentum": 0.9,
        "scheduler": "cosine",
        "sch_T_0": 10,
        "sch_T_mult": 2
    }
}
